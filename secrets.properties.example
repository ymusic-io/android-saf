# Copy to secrets.properties (gitignored) for a release-signed local build; ./encrypt.sh seals it, with the
# keystore under signing/, into the committed secrets.enc, and CI restores both with ./decrypt.sh.
# The key is YMusic's own release key: YMusic opens only a helper signed like itself.
android.signing.storeFile=signing/release.p12
android.signing.storePassword=
android.signing.keyAlias=ymusic
# android.signing.keyPassword=  (defaults to storePassword, as a PKCS12 key shares it)
